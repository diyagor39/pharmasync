# PharmaSync Backend - Environment Variables
# Fill these in with your own values. Never share this file or push it to GitHub.

PORT=5000

# TiDB Cloud connection details (same cluster as FF Weddingz, new database name)
DB_HOST=your-tidb-host.tidbcloud.com
DB_PORT=4000
DB_USER=your-tidb-username
DB_PASSWORD=your-tidb-password
DB_NAME=pharmasync_db

# JWT secret - any long random string, keep it secret
JWT_SECRET=replace-this-with-a-long-random-string

# Groq API key (same one used in MenuVision, gsk_ prefix)
GROQ_API_KEY=your-groq-api-key
